# Copy to .env and fill in. The server refuses to start if anything here is
# missing or malformed — it will print exactly which key is wrong.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# XAMPP's MySQL defaults to root with an empty password on port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vyra
DB_POOL_SIZE=10

REDIS_URL=redis://127.0.0.1:6379

# Must be at least 32 characters each, and must differ from one another:
# a leaked access secret must not also be able to mint refresh tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-48-byte-random-string-not-this
JWT_REFRESH_SECRET=change-me-to-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=vyra-media
STORAGE_ACCESS_KEY=vyra
STORAGE_SECRET_KEY=vyra-secret-key
STORAGE_PUBLIC_URL=http://127.0.0.1:9000/vyra-media

ML_SERVICE_URL=http://127.0.0.1:8000

# Upload chunk size in bytes. 5 MB suits mobile networks.
UPLOAD_CHUNK_SIZE=5242880

# Admin panel and Expo web dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

RATE_LIMIT_ENABLED=true
# Enable only when actually behind a proxy — otherwise a client can spoof its IP
# through X-Forwarded-For and evade per-IP rate limits.
TRUST_PROXY=false
